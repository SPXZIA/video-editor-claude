# Opcional: só precisa se for usar narração por IA ou a transcrição da ElevenLabs.
# Pegue a chave em https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voz padrão da narração (rode `npm run vozes` para listar as suas)
ELEVENLABS_VOICE_ID=
# Modelo de voz. eleven_multilingual_v2 fala PT-BR muito bem.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Modelo do Whisper local: medium (padrão) ou large-v3 (melhor e mais lento, ~3 GB)
WHISPER_MODELO=medium
